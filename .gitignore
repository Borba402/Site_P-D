# =============================================================================
# PINHEIRO & DESIGN — .gitignore
# Next.js 16 · TypeScript · Tailwind CSS 4
# =============================================================================

# ─── Dependências ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build / Output Next.js ──────────────────────────────────────────────────
/.next/
/out/
/build
.next/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Variáveis de ambiente (NUNCA commitar .env com valores reais) ────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# Manter apenas o exemplo:
# !.env.example

# ─── Testes & Cobertura ──────────────────────────────────────────────────────
/coverage
/.nyc_output

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Certificados & Chaves ───────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ─── Deploy / Infraestrutura ─────────────────────────────────────────────────
.vercel
.netlify
.turbo

# ─── Sistema Operacional ─────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── IDEs & Editores ─────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ─── Ferramentas de IA / Claude Code ─────────────────────────────────────────
.claude/

# ─── Análise & Profiling ─────────────────────────────────────────────────────
.clinic/
.cache/
*.heapsnapshot
