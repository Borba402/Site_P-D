# =============================================================================
# PINHEIRO & DESIGN — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o arquivo .env.local no Git.
# =============================================================================

# ─── Contato / WhatsApp ──────────────────────────────────────────────────────
# Número completo com DDI + DDD + número (sem espaços ou traços)
# Exemplo: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5511913550385

# E-mail de destino para formulário de contato (quando integrar backend/Resend)
NEXT_PUBLIC_CONTACT_EMAIL=contato@pinheirodesign.com.br

# ─── Monday.com CRM ──────────────────────────────────────────────────────────
# Onde encontrar:
#   Token   → monday.com → foto de perfil → Developers → My Access Tokens
#   Board ID → URL do board: monday.com/boards/XXXXXXXXXX
#   Group ID → Criar grupo "Leads Site" no board e inspecionar via API (abaixo)
#
# Para descobrir o Group ID do "Leads Site":
#   Acesse: https://api.monday.com/v2
#   Query: { boards(ids: [SEU_BOARD_ID]) { groups { id title } } }
#   Autorização: Bearer SEU_TOKEN
#
MONDAY_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.XXXXXXXXXXXXXXXXXXXXXXXX
MONDAY_BOARD_ID=0000000000
MONDAY_GROUP_ID=leads_site

# ─── Integrações futuras ─────────────────────────────────────────────────────
# Resend (envio de e-mails transacionais)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
